# Local Postgres from compose.local.yaml (host port 5436).
DATABASE_URL=postgres://uci:uci@localhost:5436/uci
# Migrations skip PgBouncer. Locally this is the same database.
MIGRATION_DATABASE_URL=postgres://uci:uci@localhost:5436/uci
# Valkey. Unset: cache and rate limits stay in this process.
REDIS_URL=redis://localhost:6382

# openssl rand -base64 32
AUTH_SECRET=
# Public origin. Used for the Google redirect URI.
ORIGIN=http://localhost:5173

# Comma-separated Google emails that are always platform super admins.
# The first-ever Google account also becomes super_admin. Put your real Gmail here on production (Render).
ADMIN_EMAILS=you@gmail.com

# Google OAuth web client. Both required for the real button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Question drafting. Direct Gemini runs first. OpenRouter is used only if Gemini fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=

# Private Cloudflare R2 bucket. All four required, or uploads say storage is not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uci

# Dev only: set to off for local browser test runs (ignored in production).
RATE_LIMIT=

# AI model for question generation (Gemini first; OpenRouter is the fallback). See docs/AI.md.
GEMINI_MODEL=gemini-3-flash-preview

# Web Push (Chrome / installed site). Generate with: bun scripts/vapid.ts (writes these into .env).
# The Android app uses FCM instead — set FIREBASE_SERVICE_ACCOUNT_JSON below.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Firebase Cloud Messaging (FCM) — native Android background push.
# Steps: Firebase Console → Project Settings → Service accounts → Generate new private key → download JSON.
# Paste the entire JSON as a single line (or multi-line with \n escaped). Put the same value on Render.
# Without this, the server falls back to VAPID-only (no push when Android app is fully closed).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Razorpay. Checkout is OFF in the app — payments happen on the institute's external payment page
# (set by the super admin). Set ENABLE_ONLINE_CHECKOUT=true only to test the old checkout page.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
ENABLE_ONLINE_CHECKOUT=false
